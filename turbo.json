{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "//#prettier:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/**",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!apps/*/.next/**",
        "!apps/*/out/**",
        "!apps/*/.wrangler/**",
        "!apps/*/test-results/**",
        "!apps/*/playwright-report/**",
        "!apps/*/next-env.d.ts",
        "!apps/*/*.tsbuildinfo",
        "!apps/*/coverage/**"
      ],
      "outputs": []
    },
    "//#eslint:root": {
      "inputs": ["*.mjs", "scripts/**", "package.json", "pnpm-lock.yaml"],
      "outputs": []
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"],
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:integration": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/resume/Irfan_Tayyab_SWE.tex",
        "$TURBO_ROOT$/resume/Irfan_Tayyab_SWE.pdf"
      ],
      "outputs": []
    },
    "test:all": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/resume/Irfan_Tayyab_SWE.tex",
        "$TURBO_ROOT$/resume/Irfan_Tayyab_SWE.pdf"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/resume/Irfan_Tayyab_SWE.pdf"],
      "dependsOn": ["^build", "typecheck"],
      "env": ["NEXT_PUBLIC_CF_ANALYTICS_TOKEN"],
      "outputs": ["out/**"]
    }
  }
}
